# route.cfg: settings for route.bat / route.sh. Copy this file to route.cfg
# next to route.bat and change what you need; lines starting with # are off.
#
# Scenes for "route suite": route name and savestate slot, in order. A scene
# whose slot has no savestate is skipped.
#SCENES="bower:1 wood:2"
# Measurement runs per scene (A B A B ...).
#RUNS=6
# Length of the hands-off routes (seconds), made the first time a scene runs
# and kept on the phone. To make one again at a new length, delete it first:
#   adb shell rm /sdcard/hakux_diag/routes/bower.txt
#ROUTE_SECS=75
# Cool down until the hottest GPU zone is under COOL_C degrees, at most
# COOL_MAX seconds.
#COOL_C=45
#COOL_MAX=90
# Probe length (seconds, mid-route).
#PROBE_SECS=20
# "route run": the slot, and the probe runs after the measurement runs
# (perfetto simpleperf prof, or "" for none).
#SLOT=1
#PROBES=perfetto
