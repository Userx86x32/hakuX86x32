# perfetto config for route.sh (text proto): the scheduler, CPU clocks and
# idle, thermal, the app's gfx/view trace sections, process names and stats.
# Open the trace at https://ui.perfetto.dev
buffers { size_kb: 131072 fill_policy: RING_BUFFER }
buffers { size_kb: 8192 fill_policy: RING_BUFFER }
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "thermal/thermal_temperature"
      ftrace_events: "thermal/cdev_update"
      ftrace_events: "kgsl/kgsl_pwrlevel"
      ftrace_events: "kgsl/kgsl_clk"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "input"
      atrace_categories: "power"
      atrace_apps: "com.rfandango.haku_x.debug"
      buffer_size_kb: 16384
      drain_period_ms: 250
      compact_sched { enabled: true }
    }
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 1000 }
  }
}
data_sources {
  config {
    name: "linux.sys_stats"
    target_buffer: 1
    sys_stats_config { cpufreq_period_ms: 250 }
  }
}
data_sources { config { name: "android.power" target_buffer: 1 android_power_config { battery_poll_ms: 1000 collect_power_rails: true } } }
duration_ms: 1800000
write_into_file: true
file_write_period_ms: 2500
flush_period_ms: 10000
